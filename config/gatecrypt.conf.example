# gatecrypt example config (key=value). Env GATECRYPT_* overrides.
port=8443
metrics_port=9090
io_threads=2
workers=4
ring_capacity=65536
max_frame_bytes=65536
max_connections=4096
max_conn_per_ip=256
idle_timeout_ms=15000
header_timeout_ms=5000
rate_per_sec=5000
rate_burst=1000
nonce_ttl_ms=30000
nonce_capacity=65536
clock_skew_ms=5000
data_dir=./data
wal_segment_bytes=67108864
fsync_policy=group_commit
group_commit_ms=10
allow_plain=false
tls_enabled=false
tls_cert=
tls_key=
tls_ca=
tls_require_client_cert=false
issuer_pubkey_hex=
run_user=
log_level=info
